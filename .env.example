# Environment
ENVIRONMENT=development

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
DEBUG=True

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/maas_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Vector DB (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=memory_embeddings
QDRANT_VECTOR_SIZE=384

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_LENGTH=512

# OpenAI (Optional - for advanced embeddings)
OPENAI_API_KEY=your-openai-api-key-here

# Memory Configuration
DEFAULT_MEMORY_TTL=2592000  # 30 days in seconds
MAX_MEMORY_CONTENT_LENGTH=10000
DEFAULT_TOP_K=10
MAX_TOP_K=100

# Hybrid Ranking Weights
WEIGHT_SEMANTIC=0.6
WEIGHT_RECENCY=0.2
WEIGHT_CONFIDENCE=0.1
WEIGHT_USAGE=0.1

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Metrics
ENABLE_METRICS=True
METRICS_PORT=9090
